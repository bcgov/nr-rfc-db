[loggers]
keys=root,main,ASP_download
[handlers]
keys=consoleHandler

[formatters]
keys=consoleFormatter

#----- LOGGERS

[logger_root]
level=INFO
handlers=consoleHandler


[logger_main]
level=DEBUG
handlers=consoleHandler
qualname=main
propagate=0

[logger_ASP_download]
level=DEBUG
handlers=consoleHandler
qualname=ASP_download
propagate=0

#----- HANDLERS

[handler_consoleHandler]
class=StreamHandler
formatter=consoleFormatter
args=(sys.stdout,)

#----- FORMATTERS

[formatter_consoleFormatter]
format=%(asctime)s - %(lineno)s - %(name)s - %(levelname)s - %(message)s
datefmt=%Y-%m-%d %H:%M:%S
class=logging.Formatter